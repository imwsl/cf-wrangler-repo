{
  "name": "apple-giftcard",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apple-giftcard-db",
      "database_id": "9676c012-7945-47d9-adf2-e88ebb2501ed",
      "migrations_dir": "migrations"
    }
  ]
}
